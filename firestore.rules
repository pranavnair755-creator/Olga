rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName']) &&
             data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'createdAt', 'gamesPlayed', 'highestPrize']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('gamesPlayed' in data) || data.gamesPlayed is number) &&
             (!('highestPrize' in data) || data.highestPrize is number);
    }

    function isValidGameSession(data) {
      return data.keys().hasAll(['userId', 'currentQuestionIndex', 'currentPrize', 'isGameOver']) &&
             data.keys().hasOnly(['userId', 'userName', 'currentQuestionIndex', 'currentPrize', 'isGameOver', 'isWalkAway', 'score', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             data.currentQuestionIndex is number &&
             data.currentPrize is number &&
             data.isGameOver is bool &&
             (!('isWalkAway' in data) || data.isWalkAway is bool) &&
             (!('score' in data) || data.score is number);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(gameId) && isValidGameSession(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(gameId) && isValidGameSession(incoming()) && incoming().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
